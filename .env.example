# === DATA PROVIDERS ===
# SimFin (free tier — no registration needed for "free" key)
SIMFIN_API_KEY=free
SIMFIN_DATA_DIR=hedge_fund_ai/state/simfin

# Financial Modeling Prep — earnings surprises, analyst revisions, institutional flows
# Get free key at: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_key_here

# News sentiment
NEWS_API_KEY=your_newsapi_key_here

# === LLM ===
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# === EXECUTION ===
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_DRY_RUN=true
ALPACA_PAPER=true
ALPACA_FRACTIONAL=true

# === PORTFOLIO ===
PORTFOLIO_NOTIONAL_USD=100000
TARGET_VOL=0.12
TOP_N_POSITIONS=10
MAX_POSITION_WEIGHT=0.20
MAX_SECTOR_WEIGHT=0.35
KELLY_FRACTION=0.25
CVAR_CONFIDENCE=0.95

# === RISK CONTROLS ===
STOP_LOSS_PCT=0.08
DAILY_LOSS_LIMIT=0.03
MAX_DD_HALT=0.20

# === BACKTEST ===
BACKTEST_PERIOD=10y
BACKTEST_STALE_DAYS=7
REBALANCE_DAYS=21
COST_BPS=10
IC_WINDOW=24
IC_DECAY_HALF_LIFE=12

# === NOTIFICATIONS ===
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# === PIPELINE ===
ENABLE_TRADE_EXPLANATIONS=false
RANDOM_SEED=42
MIN_UNIVERSE_SIZE=15
